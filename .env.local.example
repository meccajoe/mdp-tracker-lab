NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct database access for rollout scripts
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# HubSpot integration
HUBSPOT_API_KEY=              # Private app PAT token (already set in production)
HUBSPOT_CLIENT_SECRET=        # HubSpot app client secret for webhook signature validation
HUBSPOT_PORTAL_ID=            # HubSpot portal/account ID (for building deal URLs)

# Ada vNext model routing — server-side only
ADA_LLM_API_KEY=              # Reuse the approved Ada Anthropic credential or configure a dedicated key
ADA_OPUS_MODEL=claude-opus-4-8
ADA_VISION_MODEL=claude-sonnet-4-6

# Ada Google Sheets working copies — dedicated Mecca service account only
# Share the target Mecca Drive folder with the service account; never expose this JSON in browser code.
ADA_GOOGLE_SERVICE_ACCOUNT_JSON=
ADA_GOOGLE_DRIVE_FOLDER_ID=

# Slack project copilot
MDP_SLACK_BOT_TOKEN=          # Bot token used for Slack DMs, slash-command replies, and app mention responses
MDP_SLACK_SIGNING_SECRET=     # Signing secret used to verify /api/slack/* requests
SLACK_WEBHOOK_URL=            # Optional legacy webhook for project creation notifications
